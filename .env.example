# Variables para desarrollo local. NO subir al repo (está en .gitignore).

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sesión
SESSION_SECRET=

# Supabase (la secret key es SOLO de servidor; nunca al navegador)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# IA de voz. Se prueban los modelos en orden (con fallback): el primero que
# responda bien gana; si uno se queda sin cuota, pasa al siguiente.
# Alcanza con tener al menos una API key; los modelos sin key se saltean solos.
# Groq: crear key gratis en https://console.groq.com/keys
GROQ_API_KEY=
# Gemini: la API key NO se pudo recuperar de Vercel (es sensible).
GEMINI_API_KEY=

# Orden de modelos a probar. Formato: "proveedor:modelo" separados por coma.
# Si lo dejás vacío, se usa este mismo orden por default.
IA_MODELOS=groq:llama-3.3-70b-versatile,gemini:gemini-2.5-flash,gemini:gemini-3.1-flash-lite,gemini:gemini-2.5-flash-lite

# Mercado Pago (SOLO servidor). Cada persona conecta su cuenta desde /config
# (OAuth o pegando su token); los tokens se guardan cifrados en la DB.
# Client ID/Secret de la app de MP (panel developers) con el permiso "write"
# desactivado. Se usan para el botón "Conectar con Mercado Pago".
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Clave para cifrar los tokens en la DB (32 bytes en hex). Si se pierde, hay que
# reconectar las cuentas. Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MP_TOKEN_KEY=

# Llave con la que el cron (pg_cron en Supabase) llama a /api/mp/sync.
# No es de MP; generar una al azar, ej.: openssl rand -hex 32
CRON_SECRET=
