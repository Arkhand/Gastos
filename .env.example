# Variables para desarrollo local. NO subir al repo (está en .gitignore).

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sesión
SESSION_SECRET=

# Supabase (la secret key es SOLO de servidor; nunca al navegador)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (IA de voz). La API key NO se pudo recuperar de Vercel (es sensible).
GEMINI_API_KEY=
GEMINI_MODEL=