# Copiá este archivo como `.env` y completá los valores para desarrollo local.
# En Vercel, cargá estas mismas variables en Settings -> Environment Variables.
# NUNCA subas el archivo `.env` real al repo (está en .gitignore).

# Credenciales OAuth de Google Cloud (APIs & Services -> Credentials -> OAuth client ID, tipo "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secreto para firmar la cookie de sesión. Generá uno aleatorio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
