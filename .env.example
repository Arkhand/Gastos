# Copiá este archivo como `.env` y completá los valores para desarrollo local.
# En Vercel, cargá estas mismas variables en Settings -> Environment Variables.
# NUNCA subas el archivo `.env` real al repo (está en .gitignore).

# Credenciales OAuth de Google Cloud (APIs & Services -> Credentials -> OAuth client ID, tipo "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secreto para firmar la cookie de sesión. Generá uno aleatorio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Supabase (la service_role key es SOLO de servidor; nunca al navegador)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# IA para interpretar la voz (Google Gemini). La clave es SOLO de servidor.
# Conseguila en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: modelo a usar (por defecto gemini-2.0-flash)
GEMINI_MODEL=
