<%- include('partials/header', { titulo: 'División', user: user }) %>
<div class="app-shell">
<%- include('partials/sidebar', { tab: 'config' }) %>
<div class="app-root page-config">
  <div class="config">
    <a class="cfg-back" href="/config">‹ Configuración</a>
    <h1>División</h1>

    <% if (!dbEnabled) { %>
      <div class="recent-empty">Base de datos no configurada todavía.</div>
    <% } else { %>

    <!-- Avisos (ok / error) tras una acción -->
    <% if (ok || err) {
         var avisos = {
           division: ['ok', 'División guardada ✓'],
           'division-suma': ['err', 'Los porcentajes deben ser números entre 0 y 100 y sumar 100.'],
         }
         var a = avisos[ok || err]
         if (a) { %>
      <div class="cfg-alert cfg-alert-<%= a[0] %>"><%= a[1] %></div>
    <%   } } %>

    <p class="cfg-intro">Definí cómo se reparten los gastos compartidos entre los integrantes. Los porcentajes deben sumar 100. Este valor se usa al cerrar un mes en Resumen; los meses ya cerrados conservan el % con el que se cerraron.</p>

    <section class="cfg-card">
      <div class="cfg-card-title">Porcentaje por integrante</div>
      <form class="cfg-division" method="post" action="/config/division">
        <% division.forEach(function (d) { %>
          <div class="cfg-div-row">
            <span class="cat-chip"><%= d.emoji %> <%= d.label %></span>
            <div class="cfg-div-inp">
              <input class="inp" type="number" name="pct_<%= d.persona %>" min="0" max="100" step="1"
                     value="<%= d.porcentaje %>" inputmode="numeric" data-pct required />
              <span class="cfg-div-sign">%</span>
            </div>
          </div>
        <% }) %>
        <div class="cfg-div-suma">Suma: <span id="cfg-div-total">—</span>%</div>
        <button type="submit" class="btn-save cfg-add-btn">Guardar división</button>
      </form>
    </section>

    <% } %>
  </div>

  <%- include('partials/tabbar', { tab: 'config' }) %>
</div>
</div>

<script>
  // División: indicador de suma + auto-balanceo. Con 2 integrantes, al subir uno
  // el otro baja para que siempre sumen 100 (y viceversa).
  (function () {
    var inputs = Array.prototype.slice.call(document.querySelectorAll('[data-pct]'))
    var out = document.getElementById('cfg-div-total')
    if (!inputs.length || !out) return

    function recalc() {
      var s = inputs.reduce(function (acc, i) { return acc + (Number(i.value) || 0) }, 0)
      s = Math.round(s * 100) / 100
      out.textContent = s
      out.parentElement.classList.toggle('cfg-div-ok', Math.abs(s - 100) < 0.01)
      out.parentElement.classList.toggle('cfg-div-bad', Math.abs(s - 100) >= 0.01)
    }

    inputs.forEach(function (i) {
      i.addEventListener('input', function () {
        // Auto-balanceo solo cuando son exactamente 2 integrantes: el otro se
        // completa a 100. Si son más, solo recalculamos la suma (sin tocar nada).
        if (inputs.length === 2) {
          var n = Number(i.value)
          if (Number.isFinite(n)) {
            n = Math.max(0, Math.min(100, n))
            var otro = inputs[0] === i ? inputs[1] : inputs[0]
            otro.value = Math.round((100 - n) * 100) / 100
          }
        }
        recalc()
      })
    })
    recalc()
  })()
</script>
<%- include('partials/footer') %>
