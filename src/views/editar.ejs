<%- include('partials/header', { titulo: 'Editar gasto', user: user }) %>

<h1>Editar gasto</h1>

<% if (error) { %>
  <p style="color:#c00"><%= error %></p>
<% } %>

<form method="post" action="/gastos/<%= gasto.id %>/editar">
  <p><input name="descripcion" placeholder="Descripción" value="<%= gasto.descripcion %>" required /></p>
  <p>
    <input name="monto" type="number" step="0.01" min="0" value="<%= gasto.monto %>" required />
    <select name="moneda">
      <option value="ARS" <%= gasto.moneda === 'ARS' ? 'selected' : '' %>>ARS</option>
      <option value="USD" <%= gasto.moneda === 'USD' ? 'selected' : '' %>>USD</option>
    </select>
  </p>
  <p><input name="a_nombre_de" placeholder="A nombre de" value="<%= gasto.a_nombre_de || '' %>" /></p>
  <p><input name="categoria" placeholder="Categoría" value="<%= gasto.categoria || '' %>" /></p>
  <p><input name="fecha" type="date" value="<%= gasto.fecha || '' %>" /></p>
  <p>
    <button type="submit">Guardar cambios</button>
    <a href="/gastos">← Cancelar</a>
  </p>
</form>

<%- include('partials/footer') %>
