<%- include('partials/header', { titulo: 'Nosotros', user: user }) %>
<div class="app-shell">
<%- include('partials/sidebar', { tab: 'us' }) %>
<div class="app-root nosotros page-nosotros">
  <div class="nos-hero">
    <div class="nos-kicker">NOSOTROS</div>
    <div class="nos-title">Un equipo<br />familiar 💛</div>
    <div class="nos-text">Gastos nació en la mesa de casa, anotando en qué se nos iba la plata. Lo hacemos los tres.</div>
  </div>

  <div class="team-stage">
    <div class="team-card">
      <div class="team-photo" style="--ring: var(--lilac-deep)"><img src="/mama.jpg" alt="Mamá" /></div>
      <div class="team-name">Mamá</div>
      <div class="team-role">Las cuentas</div>
    </div>
    <div class="team-card">
      <div class="team-photo" style="--ring: var(--mint-deep)"><img src="/papa.jpg" alt="Papá" /></div>
      <div class="team-name">Papá</div>
      <div class="team-role">El que gasta</div>
    </div>
    <div class="team-card">
      <div class="team-photo" style="--ring: var(--butter-deep)"><img src="/nena.jpg" alt="Peque" /></div>
      <div class="team-name">Peque</div>
      <div class="team-role">Antojos 🍭</div>
    </div>
  </div>

  <div class="nos-quote">"Si lo decís en voz alta, ya está cargado."</div>
  <%- include('partials/tabbar', { tab: 'us' }) %>
</div>
</div>
<%- include('partials/footer') %>
