<%- include('partials/header', { titulo: 'Nosotros', user: user }) %>
<div class="app-root nosotros">
  <div class="nos-hero">
    <div class="nos-kicker">NOSOTROS</div>
    <div class="nos-title">Un equipo<br />familiar 💛</div>
    <div class="nos-text">Gastos nació en la mesa de casa, anotando en qué se nos iba la plata. Lo hacemos en familia.</div>
  </div>

  <div class="team-stage">
    <!-- MAMÁ -->
    <div class="team-card">
      <div class="team-figure">
        <div class="chibi chibi-mama">
          <div class="ch-feet">
            <div class="ch-foot" style="background:#caa07a"></div>
            <div class="ch-foot" style="background:#caa07a"></div>
          </div>
          <div class="ch-body" style="background:#241f29">
            <div class="ch-arm ch-arm-l"><div class="ch-hand"></div></div>
            <div class="ch-arm ch-arm-r"><div class="ch-hand"></div></div>
            <span class="ch-deco" style="background:#7b4ddb;left:16%;top:8%"></span>
            <span class="ch-deco" style="background:#e8527e;left:58%;top:14%"></span>
            <span class="ch-deco" style="background:#1f9d6e;left:38%;top:32%"></span>
            <span class="ch-deco" style="background:#f2b134;left:12%;top:44%"></span>
            <span class="ch-deco" style="background:#e8527e;left:64%;top:46%"></span>
            <span class="ch-deco" style="background:#2aa9c9;left:40%;top:62%"></span>
            <div class="ch-necklace"></div>
          </div>
          <div class="ch-head">
            <div class="ch-hair-crown"></div>
            <div class="ch-lock ch-lock-l"></div>
            <div class="ch-lock ch-lock-r"></div>
            <div class="ch-face">
              <div class="ch-brow ch-brow-l"></div>
              <div class="ch-brow ch-brow-r"></div>
              <div class="ch-eye ch-eye-l"><div class="ch-pupil"></div></div>
              <div class="ch-eye ch-eye-r"><div class="ch-pupil"></div></div>
              <div class="ch-cheek ch-cheek-l"></div>
              <div class="ch-cheek ch-cheek-r"></div>
              <div class="ch-nose"></div>
              <div class="ch-mouth ch-mouth-smile"></div>
            </div>
            <div class="ch-fringe ch-fringe-l"></div>
            <div class="ch-fringe ch-fringe-r"></div>
          </div>
        </div>
      </div>
      <div class="team-name">Mamá</div>
      <div class="team-role">Las cuentas</div>
    </div>

    <!-- PAPÁ -->
    <div class="team-card">
      <div class="team-figure">
        <div class="chibi chibi-papa">
          <div class="ch-feet">
            <div class="ch-foot" style="background:#33303a"></div>
            <div class="ch-foot" style="background:#33303a"></div>
          </div>
          <div class="ch-body" style="background:#eceae6">
            <div class="ch-arm ch-arm-l"><div class="ch-hand"></div></div>
            <div class="ch-arm ch-arm-r"><div class="ch-hand"></div></div>
            <div class="ch-chain"></div>
          </div>
          <div class="ch-head">
            <div class="ch-beard"></div>
            <div class="ch-face">
              <div class="ch-brow ch-brow-l"></div>
              <div class="ch-brow ch-brow-r"></div>
              <div class="ch-eye ch-eye-l"><div class="ch-pupil"></div></div>
              <div class="ch-eye ch-eye-r"><div class="ch-pupil"></div></div>
              <div class="ch-cheek ch-cheek-l"></div>
              <div class="ch-cheek ch-cheek-r"></div>
              <div class="ch-nose"></div>
              <div class="ch-mouth ch-mouth-smirk"></div>
              <div class="ch-stache-in"></div>
            </div>
            <div class="ch-hair-top"></div>
            <div class="ch-temple ch-temple-l"></div>
            <div class="ch-temple ch-temple-r"></div>
            <div class="ch-soul"></div>
            <div class="ch-earring"></div>
          </div>
        </div>
      </div>
      <div class="team-name">Papá</div>
      <div class="team-role">El que gasta</div>
    </div>

    <!-- PEQUE -->
    <div class="team-card">
      <div class="team-figure">
        <div class="chibi chibi-nena">
          <div class="ch-feet">
            <div class="ch-foot" style="background:#e08f7a"></div>
            <div class="ch-foot" style="background:#e08f7a"></div>
          </div>
          <div class="ch-body" style="background:#f2b8a8">
            <div class="ch-arm ch-arm-l"><div class="ch-hand"></div></div>
            <div class="ch-arm ch-arm-r"><div class="ch-hand"></div></div>
            <div class="ch-knit"></div>
          </div>
          <div class="ch-head">
            <div class="ch-hair-crown"></div>
            <div class="ch-lock ch-lock-l"></div>
            <div class="ch-lock ch-lock-r"></div>
            <div class="ch-face">
              <div class="ch-brow ch-brow-l"></div>
              <div class="ch-brow ch-brow-r"></div>
              <div class="ch-eye ch-eye-l"><div class="ch-pupil"></div></div>
              <div class="ch-eye ch-eye-r"><div class="ch-pupil"></div></div>
              <div class="ch-cheek ch-cheek-l"></div>
              <div class="ch-cheek ch-cheek-r"></div>
              <div class="ch-nose"></div>
              <div class="ch-mouth ch-mouth-sweet"></div>
            </div>
            <div class="ch-bangs"></div>
          </div>
        </div>
      </div>
      <div class="team-name">Peque</div>
      <div class="team-role">Antojos 🍭</div>
    </div>
  </div>

  <div class="nos-quote">"Si lo decís en voz alta, ya está cargado."</div>
  <%- include('partials/tabbar', { tab: 'us' }) %>
</div>
<%- include('partials/footer') %>
