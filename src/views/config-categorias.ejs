<%- include('partials/header', { titulo: 'Categorías', user: user }) %>
<div class="app-shell">
<%- include('partials/sidebar', { tab: 'config' }) %>
<div class="app-root page-config">
  <div class="config">
    <a class="cfg-back" href="/config">‹ Configuración</a>
    <h1>Categorías</h1>

    <% if (!dbEnabled) { %>
      <div class="recent-empty">Base de datos no configurada todavía.</div>
    <% } else { %>

    <!-- Avisos (ok / error) tras una acción -->
    <% if (ok || err) {
         var avisos = {
           creada: ['ok', 'Categoría creada ✓'],
           editada: ['ok', 'Cambios guardados ✓'],
           eliminada: ['ok', 'Categoría eliminada ✓'],
           archivada: ['ok', 'La categoría tenía gastos: quedó archivada (sus gastos se conservan) ✓'],
           revivida: ['ok', 'Categoría restaurada ✓'],
           nombre: ['err', 'Poné un nombre.'],
           largo: ['err', 'El nombre es muy largo (máx 24).'],
           existe: ['err', 'Ya existe una categoría con ese nombre.'],
           'existe-borrada': ['err', 'Existe una categoría borrada con ese nombre. Restaurala desde "Archivadas" en vez de crear una nueva.'],
           'otros-imborrable': ['err', '"Otros" no se puede borrar: es la categoría de respaldo.'],
           'revivir-choca': ['err', 'Ya hay una categoría activa con ese nombre. Renombrá o borrá la otra primero.'],
           'no-existe': ['err', 'Esa categoría no existe.'],
         }
         var a = avisos[ok || err]
         if (a) { %>
      <div class="cfg-alert cfg-alert-<%= a[0] %>"><%= a[1] %></div>
    <%   } } %>

    <p class="cfg-intro">Agregá, editá o quitá las categorías de tus gastos. La IA usa estas mismas categorías al interpretar lo que cargás por voz o a mano.</p>

    <!-- Alta de categoría -->
    <section class="cfg-card">
      <div class="cfg-card-title">Nueva categoría</div>
      <form class="cfg-new" method="post" action="/config/categorias">
        <div class="cfg-new-row">
          <input class="inp cfg-emoji-inp" name="emoji" maxlength="4" placeholder="🐾" aria-label="Emoji" />
          <input class="inp cfg-nombre-inp" name="nombre" maxlength="24" placeholder="Nombre (ej: Mascotas)" autocomplete="off" required />
          <button type="submit" class="btn-save cfg-add-btn">Agregar</button>
        </div>
        <input class="inp cfg-hint-inp" name="hint" maxlength="120" placeholder="Pista para la IA (opcional): ej veterinaria, alimento de perro" autocomplete="off" />
      </form>
    </section>

    <!-- Categorías activas -->
    <section class="cfg-card">
      <div class="cfg-card-title">Activas</div>
      <div class="cfg-list">
        <% activas.forEach(function (c) { %>
          <div class="cfg-item" data-id="<%= c.id %>">
            <div class="cfg-item-main">
              <span class="cat-chip cat-<%= c.id %>"><%= c.emoji %> <%= c.label %></span>
              <% if (c.hint) { %><span class="cfg-hint-txt"><%= c.hint %></span><% } %>
            </div>
            <div class="cfg-item-actions">
              <button type="button" class="cfg-btn cfg-edit-btn" data-edit="<%= c.id %>">Editar</button>
              <% if (!c.es_otros) { %>
                <form method="post" action="/config/categorias/<%= c.id %>/eliminar"
                      onsubmit="return confirm('¿Quitar «<%= c.label %>»? Si tiene gastos, quedará archivada y esos gastos se conservan.')">
                  <button type="submit" class="cfg-btn cfg-del-btn">Quitar</button>
                </form>
              <% } else { %>
                <span class="cfg-lock" title="La categoría de respaldo no se puede borrar">🔒</span>
              <% } %>
            </div>

            <!-- Form de edición (oculto; lo muestra el botón Editar) -->
            <form class="cfg-edit-form" id="edit-<%= c.id %>" method="post" action="/config/categorias/<%= c.id %>/editar" hidden>
              <div class="cfg-new-row">
                <input class="inp cfg-emoji-inp" name="emoji" maxlength="4" value="<%= c.emoji %>" aria-label="Emoji" />
                <input class="inp cfg-nombre-inp" name="nombre" maxlength="24" value="<%= c.label %>" autocomplete="off" required <%= c.es_otros ? 'readonly' : '' %> />
                <button type="submit" class="btn-save cfg-add-btn">Guardar</button>
              </div>
              <input class="inp cfg-hint-inp" name="hint" maxlength="120" value="<%= c.hint %>" placeholder="Pista para la IA (opcional)" autocomplete="off" />
            </form>
          </div>
        <% }) %>
      </div>
    </section>

    <!-- Categorías archivadas (borradas pero con gastos históricos) -->
    <% if (borradas.length > 0) { %>
      <section class="cfg-card">
        <div class="cfg-card-title">Archivadas</div>
        <p class="cfg-intro">Estas categorías tienen gastos viejos asociados. No aparecen al cargar ni las usa la IA. Podés restaurarlas.</p>
        <div class="cfg-list">
          <% borradas.forEach(function (c) { %>
            <div class="cfg-item cfg-item-off" data-id="<%= c.id %>">
              <div class="cfg-item-main">
                <span class="cat-chip cat-<%= c.id %>"><%= c.emoji %> <%= c.label %></span>
              </div>
              <div class="cfg-item-actions">
                <form method="post" action="/config/categorias/<%= c.id %>/revivir">
                  <button type="submit" class="cfg-btn cfg-revive-btn">Restaurar</button>
                </form>
              </div>
            </div>
          <% }) %>
        </div>
      </section>
    <% } %>

    <% } %>
  </div>

  <%- include('partials/tabbar', { tab: 'config' }) %>
</div>
</div>

<script>
  // Editar: muestra/oculta el form inline de cada categoría.
  (function () {
    document.querySelectorAll('[data-edit]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var id = btn.getAttribute('data-edit')
        var form = document.getElementById('edit-' + id)
        if (!form) return
        var ahora = form.hasAttribute('hidden')
        if (ahora) { form.removeAttribute('hidden'); btn.textContent = 'Cancelar' }
        else { form.setAttribute('hidden', ''); btn.textContent = 'Editar' }
      })
    })
  })()
</script>
<%- include('partials/footer') %>
