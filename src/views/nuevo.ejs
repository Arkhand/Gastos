<%- include('partials/header', { titulo: 'Cargar gasto', user: user }) %>

<h1>Nuevo gasto</h1>

<% if (!dbEnabled) { %>
  <p><em>Base de datos no configurada todavía.</em></p>
<% } else { %>

  <% if (error) { %>
    <p style="color:#c00"><%= error %></p>
  <% } %>

  <form method="post" action="/nuevo">
    <p><input name="descripcion" placeholder="Descripción" required /></p>
    <p>
      <input name="monto" type="number" step="0.01" min="0" placeholder="Monto" required />
      <select name="moneda">
        <option value="ARS" selected>ARS</option>
        <option value="USD">USD</option>
      </select>
    </p>
    <p><input name="a_nombre_de" placeholder="A nombre de" value="<%= user.displayName %>" /></p>
    <p><input name="categoria" placeholder="Categoría" /></p>
    <p><input name="fecha" type="date" /></p>
    <p><button type="submit">Guardar</button></p>
  </form>

  <p><a href="/gastos">Ver mis gastos →</a></p>

<% } %>

<%- include('partials/footer') %>
