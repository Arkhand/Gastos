<%- include('partials/header', { titulo: 'Mis gastos', user: user }) %>

<h1>Mis gastos</h1>

<% if (!dbEnabled) { %>
  <p><em>Base de datos no configurada todavía.</em></p>
<% } else { %>

  <table border="1" cellpadding="6" style="border-collapse:collapse;margin-top:1rem">
    <thead>
      <tr>
        <th>Fecha</th>
        <th>Descripción</th>
        <th>A nombre de</th>
        <th>Categoría</th>
        <th>Monto</th>
        <th>Cargado por</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      <% if (gastos.length === 0) { %>
        <tr><td colspan="7">Sin gastos todavía. <a href="/nuevo">Cargá el primero</a>.</td></tr>
      <% } else { %>
        <% gastos.forEach(function (g) { %>
          <tr>
            <td><%= g.fecha || '' %></td>
            <td><%= g.descripcion %></td>
            <td><%= g.a_nombre_de %></td>
            <td><%= g.categoria || '' %></td>
            <td style="text-align:right"><%= g.moneda %> $<%= Number(g.monto).toFixed(2) %></td>
            <td><%= g.cargado_por %></td>
            <td>
              <a href="/gastos/<%= g.id %>/editar">✏️ Editar</a>
              <form method="post" action="/gastos/<%= g.id %>/eliminar" style="display:inline" onsubmit="return confirm('¿Borrar este gasto?')">
                <button type="submit">🗑</button>
              </form>
            </td>
          </tr>
        <% }) %>
      <% } %>
    </tbody>
  </table>

  <p><strong>Total: <%= totalStr %></strong></p>

<% } %>

<%- include('partials/footer') %>
