<!-- Hoja inferior (bottom sheet) para cargar / editar un gasto.
     Se abre con JS (clase sheet-open en el body). El form normal postea a /nuevo;
     en modo edición, JS le cambia el action a /gastos/:id/editar. -->
<div class="scrim" data-close-sheet></div>
<div class="sheet" id="sheet" role="dialog" aria-modal="true" aria-labelledby="sheet-title">
  <div class="sheet-grab"></div>
  <div class="sheet-head">
    <div class="sheet-head-top">
      <div class="sheet-title" id="sheet-title">Nuevo gasto</div>
      <%# Switch "Personal": al activarlo, el gasto pasa a nombre del usuario logueado,
          se deshabilita el selector de persona y NO entra al reparto. Vive en el
          header (a la altura del título). Está fuera del <form>, así que lo asociamos
          con form="sheet-form" para que se envíe igual. %>
      <label class="personal-switch" title="Gasto solo mío, no entra al reparto">
        <span class="personal-switch-txt">Personal</span>
        <input type="checkbox" id="f-personal" form="sheet-form" />
        <span class="personal-switch-track"><span class="personal-switch-knob"></span></span>
      </label>
    </div>
    <div class="sheet-heard" id="sheet-heard"></div>
  </div>

  <form class="sheet-form" id="sheet-form" method="post" action="/nuevo" data-ia="<%= typeof iaEnabled !== 'undefined' && iaEnabled %>">
    <%# UUID del gasto que se está editando. Vacío = alta nueva; con valor = edición.
        Lo completa app.js al abrir la hoja en modo editar y lo limpia en modo nuevo.
        El form SIEMPRE postea a /nuevo: el backend decide crear o editar según esto,
        así un fallo de JS nunca crea un duplicado de algo que se estaba editando. %>
    <input type="hidden" name="edit_id" id="f-edit-id" value="" />
    <%# Query string del Resumen que se está viendo (mes, vista, …): al editar/borrar,
        el redirect vuelve a esa misma vista. Lo completa app.js al abrir la hoja. %>
    <input type="hidden" name="volver" id="f-volver" value="" />
    <div class="field">
      <label for="f-descripcion">¿Qué fue?</label>
      <input class="inp" name="descripcion" id="f-descripcion" placeholder="Ej: Súper" list="desc-sugerencias" autocomplete="off" />
      <datalist id="desc-sugerencias">
        <% (typeof sugerencias !== 'undefined' ? sugerencias : []).forEach(function (s) { %>
          <option value="<%= s %>"></option>
        <% }) %>
      </datalist>
    </div>

    <div class="field">
      <label for="f-monto">¿Cuánto?</label>
      <div class="money-row">
        <div class="money-inp">
          <span class="money-sign" id="money-sign">$</span>
          <input class="inp-money" name="monto" id="f-monto" type="number" inputmode="decimal" step="0.01" min="0" placeholder="0" />
        </div>
        <div class="moneda-toggle" id="moneda-toggle">
          <button type="button" class="moneda-opt is-on" data-moneda="ARS">ARS</button>
          <button type="button" class="moneda-opt" data-moneda="USD">USD</button>
        </div>
      </div>
      <input type="hidden" name="moneda" id="f-moneda" value="ARS" />
    </div>

    <div class="field">
      <label>¿A nombre de quién?</label>
      <div class="segmented" id="persona-seg" data-default="<%= personaDefault %>" data-yo="<%= personaDefault %>">
        <% personas.forEach(function (p) { %>
          <button type="button" class="seg-opt" data-persona="<%= p.id %>">
            <span class="seg-emoji"><%= p.emoji %></span><%= p.label %>
          </button>
        <% }) %>
      </div>
      <input type="hidden" name="a_nombre_de" id="f-persona" value="" />
      <%# Compartido por defecto; el checkbox de arriba lo invierte. %>
      <input type="hidden" name="compartido" id="f-compartido" value="true" />
    </div>

    <div class="field">
      <label for="cat-select">Categoría</label>
      <%# Desplegable: arranca en "Automático" (la IA elige al guardar). En modo
          edición el JS quita la opción Automático (siempre manual). El valor real
          va en el hidden #f-categoria; "__auto__" significa que decide la IA. %>
      <div class="cat-select-wrap" data-otros="<%= typeof otrosId !== 'undefined' ? otrosId : '' %>">
        <select class="inp cat-select" id="cat-select">
          <option value="__auto__" data-emoji="✨">✨ Automático (lo elige la IA)</option>
          <% categorias.forEach(function (c) { %>
            <option value="<%= c.id %>" data-emoji="<%= c.emoji %>"><%= c.emoji %>  <%= c.label %></option>
          <% }) %>
        </select>
      </div>
      <input type="hidden" name="categoria" id="f-categoria" value="<%= typeof otrosId !== 'undefined' ? otrosId : '' %>" />
    </div>

    <div class="field">
      <label>¿Cuándo?</label>
      <div class="date-row" id="date-pills">
        <button type="button" class="date-pill is-on" data-date="hoy">Hoy</button>
        <button type="button" class="date-pill" data-date="ayer">Ayer</button>
        <button type="button" class="date-pill" data-date="otro">Otro día</button>
        <input type="date" class="date-input" id="f-fecha-input" style="display:none" />
      </div>
      <input type="hidden" name="fecha" id="f-fecha" value="" />
    </div>

    <div class="sheet-actions">
      <button type="button" class="btn-ghost" data-close-sheet>Cancelar</button>
      <button type="submit" class="btn-save">Guardar gasto</button>
    </div>
  </form>

  <!-- Borrar (modo edición): form aparte, JS le pone el action y lo muestra -->
  <form id="sheet-delete-form" method="post" action="#" style="display:none" onsubmit="return confirm('¿Seguro que querés borrar este gasto?')">
    <input type="hidden" name="volver" id="f-volver-del" value="" />
    <button type="submit" class="btn-delete">🗑 Borrar gasto</button>
  </form>
</div>
