<!-- Mascota "Chubi" (todo CSS). El estado se controla con la clase chubi-<estado>
     en el contenedor; JS la cambia (idle | listening | thinking | happy). -->
<div class="chubi chubi-<%= typeof estado !== 'undefined' ? estado : 'idle' %>" id="chubi" style="width:168px;height:168px">
  <!-- efectos según estado (CSS los muestra/oculta) -->
  <div class="chubi-ring chubi-ring-1"></div>
  <div class="chubi-ring chubi-ring-2"></div>
  <div class="chubi-ring chubi-ring-3"></div>
  <div class="chubi-think"><span></span><span></span><span></span></div>
  <div class="chubi-spark chubi-spark-1">✦</div>
  <div class="chubi-spark chubi-spark-2">✦</div>
  <div class="chubi-spark chubi-spark-3">✦</div>
  <div class="chubi-spark chubi-spark-4">✧</div>

  <div class="chubi-bob">
    <div class="chubi-feet">
      <div class="chubi-foot"></div>
      <div class="chubi-foot"></div>
    </div>
    <div class="chubi-body">
      <div class="chubi-arm chubi-arm-l"></div>
      <div class="chubi-arm chubi-arm-r"></div>
      <div class="chubi-cheek chubi-cheek-l"></div>
      <div class="chubi-cheek chubi-cheek-r"></div>
      <div class="chubi-face">
        <div class="chubi-eyes">
          <div class="chubi-eye"><div class="chubi-pupil"><div class="chubi-shine"></div></div></div>
          <div class="chubi-eye"><div class="chubi-pupil"><div class="chubi-shine"></div></div></div>
          <div class="chubi-eye-happy"></div>
          <div class="chubi-eye-happy"></div>
        </div>
        <div class="chubi-mouth-wrap">
          <div class="chubi-mouth-smile"></div>
          <div class="chubi-mouth-o"></div>
          <div class="chubi-mouth-flat"></div>
          <div class="chubi-mouth-big"><div class="chubi-tongue"></div></div>
        </div>
      </div>
    </div>
  </div>
</div>
