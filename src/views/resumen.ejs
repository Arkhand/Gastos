<%- include('partials/header', { titulo: 'Resumen', user: user }) %>
<div class="app-root">
  <div class="resumen">
    <h1>Resumen</h1>

    <!-- Navegador de mes -->
    <div class="mes-nav">
      <a class="mes-arrow" data-mes="<%= prevMes %>" href="/resumen?mes=<%= prevMes %>&vista=<%= vista %>" aria-label="Mes anterior">‹</a>
      <span class="mes-label"><%= mesNombre %></span>
      <% if (showNext) { %>
        <a class="mes-arrow" data-mes="<%= nextMes %>" href="/resumen?mes=<%= nextMes %>&vista=<%= vista %>" aria-label="Mes siguiente">›</a>
      <% } else { %>
        <span class="mes-arrow mes-arrow-off">›</span>
      <% } %>
    </div>

    <!-- Cambia entre la lista de gastos y los gráficos -->
    <div class="segmented vista-seg" id="vista-seg">
      <button type="button" class="seg-opt <%= vista === 'gastos' ? 'is-on' : '' %>" data-vista="gastos">Gastos</button>
      <button type="button" class="seg-opt <%= vista === 'graficos' ? 'is-on' : '' %>" data-vista="graficos">Gráficos</button>
    </div>

    <!-- ===== Vista: Gastos (lista editable con lápiz) ===== -->
    <div class="vista <%= vista === 'gastos' ? 'is-on' : '' %>" id="vista-gastos">
      <% if (!dbEnabled) { %>
        <div class="recent-empty">Base de datos no configurada todavía.</div>
      <% } else if (grupos.length === 0) { %>
        <div class="recent-empty">Sin gastos en este mes.</div>
      <% } else { %>
        <% grupos.forEach(function (grupo) { %>
          <div class="day-group">
            <div class="day-row">
              <span class="day-label"><%= grupo.etiqueta %></span>
              <span class="day-total"><%= grupo.totalStr %></span>
            </div>
            <div class="day-card">
              <% grupo.items.forEach(function (g) { %>
                <%- include('partials/gasto-row', { g: g, editable: true }) %>
              <% }) %>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>

    <!-- ===== Vista: Gráficos (torta + barras por categoría) ===== -->
    <div class="vista <%= vista === 'graficos' ? 'is-on' : '' %>" id="vista-graficos">
      <div class="res-total">
        <div class="res-total-label">Total del mes (ARS)</div>
        <div class="res-total-amount"><%= totalMes %></div>
      </div>

      <% if (personasTotales.length > 0) { %>
        <div class="chart-card">
          <div class="chart-title">Total por persona</div>
          <% personasTotales.forEach(function (p) { %>
            <div class="persona-row">
              <span class="persona-name"><%= p.emoji %> <%= p.label %></span>
              <span class="persona-tot">
                <span class="persona-ars"><%= p.arsStr %></span>
                <span class="persona-usd"><%= p.usdStr %></span>
              </span>
            </div>
          <% }) %>
        </div>
      <% } %>

      <% if (filas.length === 0) { %>
        <div class="recent-empty">No hay gastos en pesos este mes para graficar.</div>
      <% } else { %>
        <div class="chart-card">
          <div class="chart-title">Distribución por categoría</div>
          <div class="pie-wrap">
            <div class="pie" style="background: <%= pieGradient %>"></div>
            <div class="pie-legend">
              <% filas.forEach(function (c) { %>
                <div class="leg-item">
                  <span class="leg-dot cat-<%= c.id %>"></span>
                  <span class="leg-name"><%= c.emoji %> <%= c.label %></span>
                  <span class="leg-pct"><%= c.pct %>%</span>
                </div>
              <% }) %>
            </div>
          </div>
        </div>

        <div class="chart-card">
          <div class="chart-title">Ranking por categoría</div>
          <% filas.forEach(function (c) { %>
            <div class="bar-row">
              <span class="bar-name"><%= c.emoji %> <%= c.label %></span>
              <span class="bar-track"><span class="bar-fill cat-<%= c.id %>" style="width: <%= Math.max(c.pct, 3) %>%"></span></span>
              <span class="bar-val">$ <%= c.total.toLocaleString('es-AR') %></span>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>

  <%- include('partials/sheet', { categorias: categorias, personas: personas, personaDefault: personaDefault }) %>
  <%- include('partials/tabbar', { tab: 'stats' }) %>
</div>
<%- include('partials/footer') %>
