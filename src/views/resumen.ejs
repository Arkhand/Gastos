<%- include('partials/header', { titulo: 'Resumen', user: user }) %>
<div class="app-root">
  <div class="resumen">
    <h1>Resumen</h1>

    <div class="res-total">
      <div class="res-total-label">Gastado este mes (ARS)</div>
      <div class="res-total-amount"><%= totalMes %></div>
    </div>

    <% if (!dbEnabled) { %>
      <div class="recent-empty">Base de datos no configurada todavía.</div>
    <% } else if (filas.length === 0) { %>
      <div class="recent-empty">Todavía no hay gastos en pesos este mes.</div>
    <% } else { %>
      <% filas.forEach(function (c) { %>
        <div class="res-cat">
          <span class="res-cat-emoji cat-<%= c.id %>"><%= c.emoji %></span>
          <span class="res-cat-name"><%= c.label %></span>
          <span class="res-cat-amount">$ <%= c.total.toLocaleString('es-AR') %></span>
        </div>
      <% }) %>
    <% } %>
  </div>

  <%- include('partials/tabbar', { tab: 'stats' }) %>
</div>
<%- include('partials/footer') %>
