<%- include('partials/header', { titulo: 'Resumen', user: user }) %>
<div class="app-shell">
<%- include('partials/sidebar', { tab: 'stats' }) %>
<div class="app-root page-resumen">
  <div class="resumen">
    <h1>Resumen <% if (cierre.cerrado) { %><span class="mes-cerrado-flag" title="Mes cerrado">🤝</span><% } %></h1>

    <% if (ok === 'cerrado') { %>
      <div class="cfg-alert cfg-alert-ok">Mes cerrado 🤝 — la división quedó congelada.</div>
    <% } %>

    <!-- Selector de mes: solo meses con datos cargados, de mayor a menor. Los meses
         cerrados llevan 🤝 -->
    <div class="mes-nav">
      <select class="mes-select" id="mes-select" aria-label="Elegir mes">
        <% meses.forEach(function (m) { %>
          <option value="<%= m.value %>" <%= m.value === mes ? 'selected' : '' %>><%= m.cerrado ? '🤝 ' : '' %><%= m.label %></option>
        <% }) %>
      </select>
    </div>

    <!-- Cambia entre la lista de gastos y los gráficos -->
    <div class="segmented vista-seg" id="vista-seg">
      <button type="button" class="seg-opt <%= vista === 'gastos' ? 'is-on' : '' %>" data-vista="gastos">Gastos</button>
      <button type="button" class="seg-opt <%= vista === 'graficos' ? 'is-on' : '' %>" data-vista="graficos">Gráficos</button>
    </div>

    <!-- ===== Vista: Gastos ===== -->
    <div class="vista <%= vista === 'gastos' ? 'is-on' : '' %>" id="vista-gastos">

      <!-- MOBILE: filtros (buscar + persona) sobre la lista agrupada por día -->
      <% if (dbEnabled && grupos.length > 0) { %>
      <div class="mvm-filters">
        <input class="ctl mvm-q" id="mvm-q" type="text" placeholder="Buscar… ej: súper, taxi, 5000" autocomplete="off" />
        <div class="seg mvm-per" id="mvm-per">
          <button type="button" data-v="all" class="is-on">Todos</button>
          <% personas.forEach(function (p) { %>
            <button type="button" data-v="<%= p.id %>"><%= p.emoji %></button>
          <% }) %>
        </div>
      </div>
      <% } %>

      <!-- MOBILE: lista editable con lápiz. En desktop se oculta, pero queda en el
           DOM para que el botón editar de la tabla reuse su lógica (app.js cablea
           estos lápices y la tabla simplemente los dispara). -->
      <div class="gastos-mobile">
        <div class="mvm-empty recent-empty" id="mvm-empty" hidden>Sin movimientos con esos filtros 🔍</div>
        <% if (!dbEnabled) { %>
          <div class="recent-empty">Base de datos no configurada todavía.</div>
        <% } else if (grupos.length === 0) { %>
          <div class="recent-empty">Sin gastos en este mes.</div>
        <% } else { %>
          <% grupos.forEach(function (grupo) { %>
            <div class="day-group">
              <div class="day-row">
                <span class="day-label"><%= grupo.etiqueta %></span>
                <span class="day-total"><%= grupo.totalStr %></span>
              </div>
              <div class="day-card">
                <% grupo.items.forEach(function (g) { %>
                  <%- include('partials/gasto-row', { g: g, editable: true }) %>
                <% }) %>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>

      <!-- DESKTOP: tabla detallada con filtros, totales y botón editar por fila -->
      <% if (dbEnabled) { %>
      <div class="gastos-desktop">
        <div class="mv-kpis">
          <div class="mv-kpi"><div class="mv-kpi-label">Movimientos</div><div class="mv-kpi-val" id="k-count">0</div><div class="mv-kpi-sub" id="k-count-sub">—</div></div>
          <div class="mv-kpi"><div class="mv-kpi-label">Total ARS</div><div class="mv-kpi-val coral" id="k-ars">$0</div><div class="mv-kpi-sub">pesos</div></div>
          <div class="mv-kpi"><div class="mv-kpi-label">Total USD</div><div class="mv-kpi-val" id="k-usd">US$0</div><div class="mv-kpi-sub">dólar bolsa</div></div>
          <div class="mv-kpi"><div class="mv-kpi-label">Promedio</div><div class="mv-kpi-val" id="k-avg">$0</div><div class="mv-kpi-sub">por movimiento</div></div>
        </div>

        <div class="mv-filters">
          <div class="filt filt-search">
            <label for="mv-q">Buscar</label>
            <input class="ctl" id="mv-q" type="text" placeholder="Descripción… ej: súper, taxi, farmacia" autocomplete="off" />
          </div>
          <div class="filt">
            <label>Persona</label>
            <div class="seg" id="mv-per">
              <button type="button" data-v="all" class="is-on">Todos</button>
              <% personas.forEach(function (p) { %>
                <button type="button" data-v="<%= p.id %>"><%= p.emoji %> <%= p.label %></button>
              <% }) %>
            </div>
          </div>
          <div class="filt">
            <label for="mv-cat">Categoría</label>
            <select class="ctl" id="mv-cat">
              <option value="all">Todas</option>
              <% categorias.forEach(function (c) { %>
                <option value="<%= c.id %>"><%= c.emoji %>  <%= c.label %></option>
              <% }) %>
            </select>
          </div>
          <div class="filt">
            <label for="mv-cur">Moneda</label>
            <select class="ctl" id="mv-cur">
              <option value="all">Todas</option>
              <option value="ARS">Pesos (ARS)</option>
              <option value="USD">Dólares (USD)</option>
            </select>
          </div>
          <div class="filt-right">
            <div class="filt">
              <label>Agrupar</label>
              <div class="seg" id="mv-grp">
                <button type="button" data-v="none" class="is-on">—</button>
                <button type="button" data-v="cat">Categoría</button>
                <button type="button" data-v="per">Persona</button>
              </div>
            </div>
            <button class="mv-clear" id="mv-clear" type="button">Limpiar</button>
          </div>
        </div>

        <div class="mv-tablecard">
          <div class="mv-scroll">
            <table class="tbl">
              <thead>
                <tr>
                  <th>Fecha</th>
                  <th class="col-per">Persona</th>
                  <th>Descripción</th>
                  <th>Categoría</th>
                  <th class="col-tipo">Tipo</th>
                  <th class="col-cargado">Cargado</th>
                  <th class="num">ARS</th>
                  <th class="num col-usd">USD</th>
                  <th aria-label="Editar"></th>
                </tr>
              </thead>
              <tbody id="mv-tbody"></tbody>
            </table>
          </div>
          <div class="mv-foot">
            <div class="mv-foot-label">Totales <span class="mv-foot-pill" id="foot-count">0 movimientos</span></div>
            <div class="mv-foot-tot">
              <div class="mv-foot-block"><div class="mv-foot-cap">ARS</div><div class="mv-foot-amt" id="foot-ars">$0</div></div>
              <div class="mv-foot-block"><div class="mv-foot-cap">USD</div><div class="mv-foot-amt usd" id="foot-usd">US$0</div></div>
            </div>
          </div>
        </div>
      </div>
      <% } %>
    </div>

    <!-- ===== Vista: Gráficos (torta + barras por categoría) ===== -->
    <div class="vista <%= vista === 'graficos' ? 'is-on' : '' %>" id="vista-graficos">
      <div class="res-total">
        <div class="res-total-label">Total del mes (ARS)</div>
        <div class="res-total-amount"><%= totalMes %></div>
      </div>

      <!-- ===== Cierre / ajuste de cuentas ===== -->
      <div class="chart-card cierre-card">
        <div class="cierre-head">
          <div class="chart-title">Ajuste de cuentas</div>
          <% if (cierre.cerrado) { %>
            <span class="cierre-badge">🤝 Mes cerrado</span>
          <% } %>
        </div>

        <% if (!cierre.hayCompartidos) { %>
          <div class="recent-empty">No hay gastos compartidos en este mes.</div>
        <% } else { %>
          <p class="cierre-sub">
            Total compartido: <strong><%= cierre.totalArsStr %></strong>
            <% if (cierre.totalUsdStr !== '$ 0') { %> · <strong><%= cierre.totalUsdStr %></strong><% } %>
            <span class="cierre-note">
              División
              <% cierre.pctPorPersona.forEach(function (p, i) { %><%= i ? ' / ' : '' %><%= p.emoji %> <%= p.pct %>%<% }) %>
              · los gastos personales no entran
            </span>
          </p>

          <%# Saldo agrupado por deudor: el deudor y el acreedor se nombran una sola
              vez, y los montos (ARS y/o USD) se listan juntos en el medio. Normalmente
              hay un único deudor; agrupamos por si en cada moneda debe una persona
              distinta (caso raro). "debe" en vivo / "pagó" si el mes está cerrado. %>
          <%
            var grupos = {}
            ;[cierre.saldoArs, cierre.saldoUsd].forEach(function (s) {
              if (!s) return
              var k = s.deudor.label
              if (!grupos[k]) grupos[k] = { deudor: s.deudor, acreedor: s.acreedor, montos: [] }
              grupos[k].montos.push(s.montoStr)
            })
            var llaves = Object.keys(grupos)
          %>

          <% if (llaves.length === 0) { %>
            <div class="saldo-row saldo-quits">✅ Están a mano: nadie le debe nada al otro.</div>
          <% } else { %>
            <% llaves.forEach(function (k) { var g = grupos[k] %>
              <div class="saldo-row">
                <div class="saldo-deudor"><strong><%= g.deudor.emoji %> <%= g.deudor.label %></strong> <%= cierre.cerrado ? 'pagó:' : 'debe:' %></div>
                <div class="saldo-montos">
                  <% g.montos.forEach(function (m, i) { %><%= i ? ' · ' : '' %><strong class="saldo-monto"><%= m %></strong><% }) %>
                </div>
                <div class="saldo-acreedor">a <strong><%= g.acreedor.emoji %> <%= g.acreedor.label %></strong></div>
              </div>
            <% }) %>
          <% } %>

          <% if (cierre.cerrado) { %>
            <p class="cierre-foot">🤝 Cuentas cerradas<% if (cierre.cerradoPor) { %> · por <%= cierre.cerradoPor %><% } %>.</p>
          <% } else if (cierre.esPasado) { %>
            <form class="cierre-form" method="post" action="/resumen/cerrar"
                  onsubmit="return confirm('¿Cerrar este mes? El saldo queda congelado y no se puede reabrir.')">
              <input type="hidden" name="mes" value="<%= mes %>" />
              <p class="cierre-foot">Saldo en vivo con la división actual. Al cerrar, queda congelado para este mes.</p>
              <button type="submit" class="btn-save cierre-btn">Cerrar mes 🤝</button>
            </form>
          <% } else { %>
            <p class="cierre-foot">Saldo en vivo con la división actual. El mes en curso se puede cerrar cuando termine.</p>
          <% } %>
        <% } %>
      </div>

      <% if (personasTotales.length > 0) { %>
        <div class="chart-card">
          <div class="chart-title">Total por persona</div>
          <% personasTotales.forEach(function (p) { %>
            <div class="persona-row">
              <span class="persona-name"><%= p.emoji %> <%= p.label %></span>
              <span class="persona-tot">
                <span class="persona-ars"><%= p.arsStr %></span>
                <span class="persona-usd"><%= p.usdStr %></span>
              </span>
            </div>
          <% }) %>
        </div>
      <% } %>

      <% if (filas.length === 0) { %>
        <div class="recent-empty">No hay gastos en pesos este mes para graficar.</div>
      <% } else { %>
        <div class="chart-card">
          <div class="chart-title">Distribución por categoría</div>
          <div class="pie-wrap">
            <div class="pie" style="background: <%= pieGradient %>"></div>
            <div class="pie-legend">
              <% filas.forEach(function (c) { %>
                <div class="leg-item">
                  <span class="leg-dot cat-<%= c.id %>"></span>
                  <span class="leg-name"><%= c.emoji %> <%= c.label %></span>
                  <span class="leg-pct"><%= c.pct %>%</span>
                </div>
              <% }) %>
            </div>
          </div>
        </div>

        <div class="chart-card">
          <div class="chart-title">Ranking por categoría</div>
          <% filas.forEach(function (c) { %>
            <div class="bar-row">
              <span class="bar-name"><%= c.emoji %> <%= c.label %></span>
              <span class="bar-track"><span class="bar-fill cat-<%= c.id %>" style="width: <%= Math.max(c.pct, 3) %>%"></span></span>
              <span class="bar-val">$ <%= c.total.toLocaleString('es-AR') %></span>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>

  <%- include('partials/sheet', { categorias: categorias, otrosId: otrosId, personas: personas, personaDefault: personaDefault, sugerencias: sugerencias, iaEnabled: iaEnabled }) %>
  <%- include('partials/tabbar', { tab: 'stats' }) %>
</div>
</div>

<% if (dbEnabled) { %>
<script>
  window.__MOVS = <%- movsJson %>;
</script>
<script>
(function () {
  'use strict'
  var DATA = window.__MOVS || []
  var tbody = document.getElementById('mv-tbody')
  if (!tbody) return

  var state = { q: '', per: 'all', cat: 'all', cur: 'all', grp: 'none' }

  function fmtARS(n) { return n == null ? '—' : '$' + Math.round(n).toLocaleString('es-AR') }
  function fmtUSD(n) { return n == null ? '—' : 'US$' + Math.round(n).toLocaleString('es-AR') }
  function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] }) }
  function sumArs(r) { return r.reduce(function (s, x) { return s + (x.ars || 0) }, 0) }
  function sumUsd(r) { return r.reduce(function (s, x) { return s + (x.usd || 0) }, 0) }
  function byFechaDesc(a, b) { return a.fecha < b.fecha ? 1 : a.fecha > b.fecha ? -1 : 0 }
  function setText(id, v) { var el = document.getElementById(id); if (el) el.textContent = v }

  function filtered() {
    return DATA.filter(function (r) {
      return (state.per === 'all' || r.per === state.per) &&
        (state.cat === 'all' || r.cat === state.cat) &&
        (state.cur === 'all' || r.cur === state.cur) &&
        (state.q === '' || r.desc.toLowerCase().indexOf(state.q.toLowerCase()) > -1)
    })
  }

  function rowHTML(r) {
    var badge = '<span class="cur-badge cur-' + (r.cur === 'USD' ? 'usd' : 'ars') + '">' + r.cur + '</span>'
    var cargado = (r.cur === 'USD' ? 'US$' : '$') + Math.round(r.amt).toLocaleString('es-AR')
    var tipo = r.compartido
      ? '<span class="tipo-chip tipo-comp">🤝 Compartido</span>'
      : '<span class="tipo-chip tipo-pers">👤 Personal</span>'
    return '<tr>' +
      '<td class="td-date">' + esc(r.fechaLabel) + '</td>' +
      '<td class="col-per"><span class="per-cell"><span class="per-emoji">' + r.perEmoji + '</span>' + esc(r.perLabel) + '</span></td>' +
      '<td class="desc-cell">' + esc(r.desc) + '</td>' +
      '<td><span class="cat-chip cat-' + r.cat + '">' + r.catEmoji + ' ' + esc(r.catLabel) + '</span></td>' +
      '<td class="col-tipo">' + tipo + '</td>' +
      '<td class="col-cargado"><span class="cargado"><span class="num">' + cargado + '</span>' + badge + '</span></td>' +
      '<td class="num">' + fmtARS(r.ars) + '</td>' +
      '<td class="num usd-col col-usd">' + fmtUSD(r.usd) + '</td>' +
      '<td class="mv-edit-cell"><button type="button" class="mv-edit" data-edit-id="' + r.id + '" aria-label="Editar gasto">✏️</button></td>' +
      '</tr>'
  }

  function grpHeader(rows) {
    var f = rows[0]
    var label = state.grp === 'cat' ? f.catLabel : f.perLabel
    var emoji = state.grp === 'cat' ? f.catEmoji : f.perEmoji
    return '<tr class="grp-row"><td colspan="9"><div class="grp-inner">' +
      '<span class="grp-name">' + emoji + ' ' + esc(label) + ' <span class="grp-count">· ' + rows.length + ' mov.</span></span>' +
      '<span class="grp-tot"><span class="num">' + fmtARS(sumArs(rows)) + '</span><span class="num usd-col">' + fmtUSD(sumUsd(rows)) + '</span></span>' +
      '</div></td></tr>'
  }

  function render() {
    var rows = filtered()
    var html = ''
    if (rows.length === 0) {
      html = '<tr class="empty-row"><td colspan="9">Sin movimientos con estos filtros 🔍</td></tr>'
    } else if (state.grp === 'none') {
      rows.slice().sort(byFechaDesc).forEach(function (r) { html += rowHTML(r) })
    } else {
      var keyOf = function (r) { return state.grp === 'cat' ? r.cat : r.per }
      var groups = {}
      rows.forEach(function (r) { (groups[keyOf(r)] = groups[keyOf(r)] || []).push(r) })
      Object.keys(groups)
        .sort(function (a, b) { return sumArs(groups[b]) - sumArs(groups[a]) })
        .forEach(function (k) {
          var g = groups[k].slice().sort(byFechaDesc)
          html += grpHeader(g)
          g.forEach(function (r) { html += rowHTML(r) })
        })
    }
    tbody.innerHTML = html

    var tArs = sumArs(rows), tUsd = sumUsd(rows)
    setText('k-count', rows.length)
    setText('k-count-sub', 'de ' + DATA.length + ' en el mes')
    setText('k-ars', fmtARS(tArs))
    setText('k-usd', fmtUSD(tUsd))
    setText('k-avg', fmtARS(rows.length ? tArs / rows.length : 0))
    setText('foot-count', rows.length + (rows.length === 1 ? ' movimiento' : ' movimientos'))
    setText('foot-ars', fmtARS(tArs))
    setText('foot-usd', fmtUSD(tUsd))
  }

  // Editar desde la tabla: dispara el lápiz de la lista mobile (oculta en desktop
  // pero presente en el DOM), que app.js ya tiene cableado para abrir la hoja.
  tbody.addEventListener('click', function (e) {
    var b = e.target.closest('.mv-edit')
    if (!b) return
    var id = b.getAttribute('data-edit-id')
    var pencil = document.querySelector('.gastos-mobile .exp-row[data-id="' + id + '"] .exp-edit')
    if (pencil) pencil.click()
  })

  var q = document.getElementById('mv-q')
  if (q) q.addEventListener('input', function (e) { state.q = e.target.value; render() })
  var catSel = document.getElementById('mv-cat')
  if (catSel) catSel.addEventListener('change', function (e) { state.cat = e.target.value; render() })
  var curSel = document.getElementById('mv-cur')
  if (curSel) curSel.addEventListener('change', function (e) { state.cur = e.target.value; render() })

  function wireSeg(id, key) {
    var seg = document.getElementById(id)
    if (!seg) return
    seg.addEventListener('click', function (e) {
      var b = e.target.closest('button')
      if (!b) return
      seg.querySelectorAll('button').forEach(function (x) { x.classList.remove('is-on') })
      b.classList.add('is-on')
      state[key] = b.getAttribute('data-v')
      render()
    })
  }
  wireSeg('mv-per', 'per')
  wireSeg('mv-grp', 'grp')

  var clear = document.getElementById('mv-clear')
  if (clear) clear.addEventListener('click', function () {
    state = { q: '', per: 'all', cat: 'all', cur: 'all', grp: 'none' }
    if (q) q.value = ''
    if (catSel) catSel.value = 'all'
    if (curSel) curSel.value = 'all'
    document.querySelectorAll('#mv-per button, #mv-grp button').forEach(function (b) {
      b.classList.toggle('is-on', b.getAttribute('data-v') === 'all' || b.getAttribute('data-v') === 'none')
    })
    render()
  })

  render()
})();

// ===== MOBILE: filtros (buscar + persona) sobre la lista agrupada por día =====
;(function () {
  var cont = document.querySelector('.gastos-mobile')
  var qEl = document.getElementById('mvm-q')
  var perSeg = document.getElementById('mvm-per')
  var empty = document.getElementById('mvm-empty')
  if (!cont || (!qEl && !perSeg)) return

  var state = { q: '', per: 'all' }

  function aplicar() {
    var q = state.q.toLowerCase().trim()
    // Para buscar por monto: dejamos solo dígitos del query (ej. "5.000" -> "5000").
    var qNum = q.replace(/[^0-9]/g, '')
    var filtrando = q !== '' || state.per !== 'all'
    var visibles = 0
    // Mostrar/ocultar cada gasto según búsqueda (descripción o monto) + persona.
    cont.querySelectorAll('.day-group').forEach(function (grupo) {
      var enGrupo = 0
      grupo.querySelectorAll('.exp-row').forEach(function (row) {
        var desc = (row.getAttribute('data-descripcion') || '').toLowerCase()
        var per = row.getAttribute('data-nombre') || ''
        // Monto crudo sin separadores ni decimales (ej. "5000.5" -> "5000").
        var monto = (row.getAttribute('data-monto') || '').split('.')[0].replace(/[^0-9]/g, '')
        var matchTexto = q === '' ||
          desc.indexOf(q) > -1 ||
          (qNum !== '' && monto.indexOf(qNum) > -1)
        var ok = (state.per === 'all' || per === state.per) && matchTexto
        row.style.display = ok ? '' : 'none'
        if (ok) { enGrupo++; visibles++ }
      })
      // Ocultar el día entero si no quedó ningún gasto visible.
      grupo.style.display = enGrupo ? '' : 'none'
      // El total del día viene del backend (todos los gastos): al filtrar dejaría de
      // ser cierto, así que lo escondemos mientras haya filtros activos.
      var tot = grupo.querySelector('.day-total')
      if (tot) tot.style.visibility = filtrando ? 'hidden' : ''
    })
    if (empty) empty.hidden = visibles > 0
  }

  if (qEl) qEl.addEventListener('input', function (e) { state.q = e.target.value; aplicar() })
  if (perSeg) perSeg.addEventListener('click', function (e) {
    var b = e.target.closest('button')
    if (!b) return
    perSeg.querySelectorAll('button').forEach(function (x) { x.classList.remove('is-on') })
    b.classList.add('is-on')
    state.per = b.getAttribute('data-v')
    aplicar()
  })
})()
</script>
<% } %>
<%- include('partials/footer') %>
